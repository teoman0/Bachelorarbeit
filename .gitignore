# Generated arrays, predictions, and metrics belong in data/cache/ or outputs/.
# Their extensions and filenames remain visible elsewhere so that small test
# fixtures and curated tables can still be versioned deliberately.

# Large or generated archives
*.zip
*.tar
*.tar.gz
*.7z

# Keep curated reports versionable by default.

# Local dataset audit artifacts with possible raw-data references.
reports/figures/sample_grid_per_class.png
reports/figures/*sample*
reports/figures/*grid*
reports/tables/image_inventory.csv
reports/tables/potential_duplicates.csv
reports/tables/dataset_audit_metadata.json
